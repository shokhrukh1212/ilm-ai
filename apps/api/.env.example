# ── Supabase ──────────────────────────────────────────────────────────────────
# Find URL and keys in: Supabase dashboard → Settings → API
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Find JWT secret in: Supabase dashboard → Settings → API → JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret

# Storage bucket name — created by migration, keep as "materials"
SUPABASE_STORAGE_BUCKET=materials

# ── Database ──────────────────────────────────────────────────────────────────
# Supabase dashboard → Settings → Database → Connection string → URI
# Use the "Session mode" URI (port 5432), then prepend +asyncpg:
# postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.xxxx.supabase.co:5432/postgres

# ── AI providers ──────────────────────────────────────────────────────────────
# OpenAI — platform.openai.com → API keys (used for quiz generation via GPT-4o)
OPENAI_API_KEY=sk-...

# Anthropic — console.anthropic.com → API keys
ANTHROPIC_API_KEY=sk-ant-...

# Cohere — used for embeddings (embed-multilingual-v3.0, 1024 dims)
# dashboard.cohere.com → API keys
COHERE_API_KEY=...

# ── Future phases (leave empty for now) ──────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
PAYME_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
PAYTECH_LICENSE_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
IS_TEST_MODE=True
APP_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
